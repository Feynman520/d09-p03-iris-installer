{
  "forbiddenNames": ["**/.env", "**/secrets/**", "**/auth.json", "**/teamclaude.json", "**/*.token", "**/credentials*", "**/.git/**", "**/auth.bin", "**/keys.bin", "**/modules/*/state/**", "**/.stack", "**/.supa"],
  "forbiddenStrings": [],
  "forbiddenRegex": [
    {
      "pattern": "iris:[a-z0-9]{8}",
      "skipUnder": ["비서 에이전트 세팅가이드(*실행판)_v*_최신.md", "AGENTS.md"]
    },
    {
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[a-z]{2,}",
      "skipUnder": ["node_modules/", "node-v*-win-x64.zip!", "MinGit-*-64-bit.zip!", "rules.json", "sanitize.test.mjs"]
    },
    {
      "pattern": "C:[\\\\/]+IRIS[\\\\/]",
      "skipUnder": ["lock.json", "sanitize.test.mjs"]
    },
    {
      "pattern": "C:[\\\\/]+Users[\\\\/]+[^\\\\/]+",
      "skipUnder": ["node_modules/", "sanitize-local.example.json"]
    }
  ],
  "allowFiles": ["**/LICENSE*", "**/node_modules/**/*.md"],
  "maxBytes": 629145600
}
